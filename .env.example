# Fill these four values, then run npm run configure.
APP_ORIGIN=https://tesla.example.com
TESLA_REGION=cn
TESLA_CLIENT_ID=replace-with-your-tesla-client-id
TESLA_CLIENT_SECRET="replace-with-your-tesla-client-secret"

# MCP is read-only until this is explicitly enabled; API_KEY is still required.
MCP_ALLOW_CONTROL=false
# Separate frontend origins, comma separated; never use *.
CORS_ORIGINS=

# Optional for CF, useful for non-interactive deployment.
CLOUDFLARE_ACCOUNT_ID=
WORKER_NAME=tesla-agent-bridge
# configure derives DOMAIN from APP_ORIGIN for Docker/Caddy.
DOMAIN=tesla.example.com
